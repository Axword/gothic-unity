{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPC Schema",
  "type": "object",
  "properties": {
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nameKey", "faction"],
        "properties": {
          "id": { "type": "string" },
          "nameKey": { "type": "string" },
          "faction": { "type": "string" },
          "scheduleId": { "type": "string" }
        }
      }
    }
  }
}
