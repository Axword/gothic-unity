{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Items Schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nameKey", "itemType"],
        "properties": {
          "id": { "type": "string" },
          "nameKey": { "type": "string" },
          "descriptionKey": { "type": "string" },
          "itemType": { "enum": ["Weapon", "Armor", "Consumable", "Material", "QuestItem", "Key", "Ammo", "Treasure"] },
          "subType": { "type": "string" },
          "baseValue": { "type": "integer" },
          "weight": { "type": "number" },
          "damage": {
            "type": "object",
            "properties": {
              "min": { "type": "integer" },
              "max": { "type": "integer" },
              "type": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
