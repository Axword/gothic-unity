    "quest": {
      "nodeId": "quest",
      "speaker": "Wiedźma z Bagn",
      "text": "Dobra. Serce wilka. Potem wracaj. Bagna będą pamiętać.",
      "choices": [
        {
          "text": "[Odejdź]",
          "conditions": [],
          "actions": [],
          "nextNode": null
        }
      ]
    },
    "no_trade": {
      "nodeId": "no_trade",
      "speaker": "Wiedźma z Bagn",
      "text": "To wracaj, jak będziesz miał coś więcej niż słowa.",
      "choices": [
        {
