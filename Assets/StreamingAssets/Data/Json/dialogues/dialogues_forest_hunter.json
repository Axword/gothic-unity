    "bear": {
      "nodeId": "bear",
      "speaker": "Myśliwy",
      "text": "Niedźwiedź na północy. Duży i zły. Jeśli chcesz się z nim zmierzyć — lepiej weź ze sobą kogoś. Albo nie wracaj.",
