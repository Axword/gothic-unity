  "nodes": {
    "start": {
      "nodeId": "start",
      "speaker": "Mistik",
      "text": "Gwiazdy szepczą. A ty... masz w oczach pył z drogi. Czego szukasz w mroku?",
      "choices": [
        {
          "text": "Chcę poznać przyszłość.",
          "conditions": [],
          "actions": [],
          "nextNode": "future"
        },
        {
          "text": "Potrzebuję zaklęcia.",
          "conditions": [],
          "actions": [],
          "nextNode": "spell"
        },
        {
          "text": "Mam pytania o frakcje.",
          "conditions": [],
          "actions": [],
          "nextNode": "factions"
        },
        {
          "text": "Odchodzę.",
          "conditions": [],
          "actions": [],
          "nextNode": null
        }
      ]
    },
    "future": {
      "nodeId": "future",
      "speaker": "Mistik",
      "text": "Przyszłość? Widzę krew i żelazo. Wybierzesz stronę... a potem pożałujesz. Albo nie. Wszystko jedno.",
      "choices": [
        {
          "text": "A jeśli nie wybiorę?",
          "conditions": [],
          "actions": [],
          "nextNode": "neutral"
        }
      ]
    },
    "spell": {
      "nodeId": "spell",
      "speaker": "Mistik",
      "text": "Czar? Mogę ci dać jeden. Ale zapłacisz krwią własnej duszy. Albo po prostu złotem. Co wolisz?",
      "choices": [
        {
          "text": "Dam złoto.",
          "conditions": [
            { "type": "HasGold", "amount": 40 }
          ],
          "actions": [
            { "type": "SpendGold", "amount": 40 },
            { "type": "GiveItem", "itemId": "spell_icebolt", "count": 1 }
          ],
          "nextNode": "bought"
        },
        {
          "text": "Nie, dziękuję.",
          "conditions": [],
          "actions": [],
          "nextNode": null
        }
      ]
    },
    "factions": {
      "nodeId": "factions",
      "speaker": "Mistik",
      "text": "Stary Porządek — zimna stal. Nowy — gorący ogień. Oba palą. Wybierz ten, który mniej boli.",
      "choices": [
        {
          "text": "Dziękuję za mądrość.",
          "conditions": [],
