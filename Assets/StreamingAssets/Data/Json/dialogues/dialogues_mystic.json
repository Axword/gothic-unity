    "neutral": {
      "nodeId": "neutral",
      "speaker": "Mistik",
      "text": "Mądry wybór. Albo głupi. Czas pokaże.",
      "choices": [
        {
          "text": "[Odejdź]",
          "conditions": [],
          "actions": [],
          "nextNode": null
